    "@vitest/coverage-v8": "^1.6.0",
    "adm-zip": "^0.5.14",
    "tsup": "^8.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "nuclear": {
    "displayName": "NuclearTube",
    "category": "streaming",
